# Copy to .env and replace every value:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Postgres superuser (used only by the init script)
POSTGRES_PASSWORD=change-me-postgres

# One database role per service (database-per-service)
USER_DB_PASSWORD=change-me-user
PRODUCT_DB_PASSWORD=change-me-product
INVENTORY_DB_PASSWORD=change-me-inventory
ORDER_DB_PASSWORD=change-me-order

# Shared JWT signing key. HS256 requires AT LEAST 32 bytes, or token creation fails.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-chars

# Optional: host ports, change if they clash with something already running on your machine
# GATEWAY_HOST_PORT=8080
# EUREKA_HOST_PORT=8761
# POSTGRES_HOST_PORT=15432
# KAFKA_HOST_PORT=29092
# ELASTICSEARCH_HOST_PORT=19200
